# Server-side Weather API Configuration
# Set this only in Netlify's environment-variable settings. Never expose it with a VITE_ prefix.
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Error Monitoring & Sentry Integration (Production)
# Get your DSN from: https://sentry.io
# Required for production error tracking and monitoring
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Application Version
VITE_APP_VERSION=1.0.0

# API Configuration
# Optional: Configure API endpoints if backend services are used
VITE_API_ENDPOINT=https://api.example.com
VITE_CONTACT_EMAIL=contact@snowpros.com

# Analytics & Monitoring (optional)
# VITE_ANALYTICS_ID=

# Feature Flags (optional)
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_WEATHER_WIDGET=true

# IMPORTANT SECURITY NOTES:
# - Never commit .env.local with real secret values
# - Always add .env.local to .gitignore
# - Use Netlify environment variables for production secrets
# - Never prefix confidential credentials with VITE_
# - Rotate API keys immediately if they are exposed
# - Use different keys for development and production

